{
  "name": "calculadora-tecmi",
  "private": true,
  "description": "Raíz del repo: orquesta pruebas y cobertura (SonarQube) de backend, frontend y admin.",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/backend",
      "<rootDir>/frontend",
      "<rootDir>/admin"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.context/",
      "/qa-evidencia/"
    ],
    "collectCoverageFrom": [
      "backend/**/*.js",
      "frontend/js/**/*.js",
      "admin/js/**/*.js",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!backend/migrations/**",
      "!**/*.min.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageDirectory": "coverage",
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  }
}
