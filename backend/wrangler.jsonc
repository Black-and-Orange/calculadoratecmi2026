{
  // Staging del backend en Cloudflare Workers.
  // El server Express (index.js) corre tal cual vía nodejs_compat (worker.js).
  "name": "calculadora-tecmi-backend",
  "main": "worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  // Dominio propio del backend (BnO) — evita el genérico *.workers.dev.
  "routes": [
    { "pattern": "api-tecmi.blnolabs.dev", "custom_domain": true }
  ],
  "vars": {
    // En el Worker el puerto es solo una clave de ruteo interna.
    "PORT": "3008"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fb7943fa2fca4f0b8efedf82b09d27a6"
    }
  ],
  "observability": {
    "enabled": true
  }
}
