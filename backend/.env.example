# Configuración del backend — copiar a .env y llenar los valores reales.
# El .env real NO debe commitearse (está en .gitignore).

# Base de datos MySQL (AWS RDS)
DB_HOST=
DB_USER=
DB_PASSWORD=

# Puerto del servidor Express
PORT=3008

# Secreto para firmar los JWT del admin (generar con: openssl rand -hex 32)
JWT_SECRET=
